# RoboticsIpcModule router unit (Phase E E2 example).
#
# Edit the paths under [Service] for your install layout before enabling.
# See robotics-ipc-module/deploy/systemd/README.md for installation steps,
# customization knobs, and known limitations.

[Unit]
Description=RoboticsIpcModule router
Documentation=file:///opt/rim/docs/robotics-reference-layout.md
Documentation=https://github.com/sbow/RoboticsIpcModule

# Bring up after the network stack so UDP / UDS profiles work; SHM-only
# deployments don't need this but it's harmless. Adjust to After=local-fs.target
# only if you know you'll never run a datagram profile here.
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify (C6, ADR 0015).
#
# router_server sends sd_notify("READY=1") AFTER it has bound its SHM regions /
# UDS socket / UDP port (router_app.h router_notify_ready(), invoked from
# run_forward_loop once all endpoints are up). systemd therefore holds peer
# units gated `After=rim-router.service` + `Requires=` until the router is
# actually ready -- they no longer race the router's first shm_open / bind.
#
# The notify is implemented inline (no libsystemd dependency -- it writes the
# READY=1 datagram to $NOTIFY_SOCKET directly), so the binary links nothing new.
# NotifyAccess=main: only the main process may send readiness (the default; set
# explicitly as documentation -- the router is single-process).
#
# Peer code should STILL retry its first connect with backoff as a backstop
# (defence in depth if a future deployment reverts to Type=simple) -- see the
# rim-peer@.service notes.
Type=notify
NotifyAccess=main

# Profile selects transport (SHM / UDS / UDP) + peer addresses + per-peer
# ring sizing. Ship one TOML per deployment under /etc/rim/ and reference
# it here. Swap profiles by editing this path or by using a drop-in.
ExecStart=/opt/rim/bin/router_server --config /etc/rim/router.toml

# Default KillMode=control-group + KillSignal=SIGTERM gives the router its
# clean shutdown path (router_app's stop handler unwinds the forward loop
# and closes file descriptors).
TimeoutStopSec=5s

# Cleanup runs AFTER the main process exits. The router unlinks-then-creates
# SHM regions on every bind, so leftover /dev/shm/rim_router_* is normally
# safe across restarts. We still rm -f here so an operator who switches
# profiles or reboots gets a clean slate. Idempotent.
ExecStopPost=/opt/rim/libexec/rim-router-cleanup.sh

# Restart policy: come back up on crash, but back off so a wedged config
# doesn't spin the CPU.
Restart=on-failure
RestartSec=1s

# --- Production hardening (C7, ADR 0016). Commented out by default.
#
# Two complementary layers; enable per your hardware. All are opt-in so the
# default deployment behaves exactly as before.
#
# (1) systemd-enforced limits/placement (recommended, no app cooperation):
# MemoryLock=infinity        # allow mlockall; grants CAP_IPC_LOCK + RLIMIT_MEMLOCK
# CPUAffinity=2              # pin to an isolated core (pair with isolcpus=)
# LimitRTPRIO=80             # allow SCHED_FIFO up to priority 80 (see note)
# Nice=-10                   # boost scheduling priority
#
# (2) in-process hooks the router calls when these env vars are set
#     (router_app.h router_lock_memory() / router_pin_to_core(); ADR 0016).
#     Useful when you want the lock/pin done from inside the process (e.g. to
#     mlock AFTER the SHM rings are mapped). LimitRTPRIO above must still be
#     set for any SCHED_FIFO wrapper; the router does NOT call
#     sched_setscheduler itself (left to a systemd/exec wrapper by design).
# Environment=RIM_MLOCK=1               # router calls mlockall(MCL_CURRENT|MCL_FUTURE)
# Environment=RIM_CPU=2                 # router pins its thread to core 2
# Environment=RIM_PRIORITY_DROP_FLOOR=4 # SHM: shed priority<4 frames on backpressure

# Sandboxing (safe defaults; relax if your deployment needs more).
NoNewPrivileges=yes
ProtectSystem=strict
# SHM regions live under /dev/shm; UDS sockets typically under /tmp or
# /run/rim depending on profile. Adjust ReadWritePaths to match your
# topology TOML's `listen` / `local` paths.
ReadWritePaths=/dev/shm /tmp /run/rim
ProtectHome=yes
# PrivateTmp=no because SHM regions show up under /tmp on systems that
# bind-mount /dev/shm there, and UDS profiles place sockets under /tmp.
PrivateTmp=no

# Journald captures stdout/stderr; the router's RouterLogFn defaults to
# stderr in router_server.cpp (demo_stderr_logger). View with:
#   journalctl -u rim-router.service -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
